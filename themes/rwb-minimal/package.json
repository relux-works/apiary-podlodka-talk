{
  "name": "slidev-theme-rwb-minimal",
  "version": "0.1.0",
  "description": "RWB minimal theme: dark typographic developer-session style with RWB accents (lilac / orange / lime), vector pixel motifs, modest logo",
  "keywords": [
    "slidev-theme",
    "slidev",
    "rwb"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "slidev": ">=0.50.0"
  },
  "slidev": {
    "defaults": {
      "colorSchema": "dark",
      "highlighter": "shiki",
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "fonts": {
        "sans": "Inter",
        "mono": "JetBrains Mono",
        "weights": "400,600,700"
      },
      "transition": "none",
      "lineNumbers": false
    }
  }
}