{
  "name": "apiary-podlodka-talk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Рой над одной средой — Podlodka talk by Relux Works, slides as code (Slidev)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "slidev slides/slides.md --open",
    "start": "slidev slides/slides.md",
    "dev:flat": "VITE_FLAT_CLICKS=1 slidev slides/slides.md",
    "diagrams": "slidev slides/diagrams.md --open",
    "demos": "slidev slides/demos.md --open",
    "lint": "python3 .scripts/check-frontmatter.py slides/slides.md slides/diagrams.md slides/demos.md themes/rwb-tech/example.md themes/rwb-minimal/example.md",
    "verify": ".scripts/verify.sh slides/slides.md",
    "timing": "python3 .scripts/timing.py slides/slides.md --demo 'Демо 1=3,Демо 2=2'",
    "build": "slidev build slides/slides.md --out ../dist",
    "build:offline": "slidev build slides/slides.md --base ./ --out ../.temp/dist-offline",
    "export": "mkdir -p .temp/export && slidev export slides/slides.md --per-slide --output .temp/export/apiary-podlodka-talk.pdf",
    "notes": "mkdir -p .temp/export && slidev export-notes slides/slides.md --output .temp/export/notes.pdf",
    "agent-hours": "node .scripts/agent-hours.mjs",
    "present": ".scripts/present.sh start",
    "present:status": ".scripts/present.sh status",
    "present:stop": ".scripts/present.sh stop",
    "join": ".scripts/join.sh",
    "check:sync": "node .scripts/sync-check.mjs --port 8096",
    "theme:rwb-tech": "slidev themes/rwb-tech/example.md --open",
    "theme:rwb-minimal": "slidev themes/rwb-minimal/example.md --open"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/types": "^52.19.1",
    "unocss": "^66.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.63.0"
  }
}
