{
  "name": "rwb-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#2B2B2B",
    "editor.foreground": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A3A8B1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#BF97F1"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FE5F00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A3A8B1"
      }
    },
    {
      "scope": [
        "constant.other.option",
        "keyword.other.option",
        "entity.other.attribute-name",
        "variable.parameter.option",
        "support.constant",
        "meta.attribute",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#BF97F1"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    }
  ]
}